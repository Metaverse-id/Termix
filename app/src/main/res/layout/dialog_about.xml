<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_termix_logo"
            android:contentDescription="Termix Logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Termix"
                android:textColor="@color/termix_green_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0 — Native Android Terminal"
                android:textColor="@color/termix_text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Termix is a native Android terminal emulator engineered for speed, modularity, and broad compatibility across Android versions."
        android:textColor="@color/termix_text_primary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Security &amp; Sandboxing:\n• Termix operates within its Android application sandbox: /data/data/com.csoftware.termix.\n• This private storage is strictly isolated and inaccessible to other apps without root.\n• Optional root support allows running an elevated shell session (#) without forcing root on ordinary commands."
        android:textColor="@color/termix_text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_about_close"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="end"
        android:text="Close"
        android:textSize="12sp"
        android:textColor="@color/termix_text_primary"
        android:background="@drawable/bg_key_btn"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />
</LinearLayout>
